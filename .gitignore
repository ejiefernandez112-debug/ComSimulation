# Godot 4 cache / generated files
.godot/
*.import
/android/
/build/
/export/

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Raw downloaded 3D model kits: big, free to re-download, likely to be swapped.
# Only the sprites made from them (assets/buildings/) are committed. Keep each kit's .gdignore.
/Sprites kit/**
!/Sprites kit/.gdignore

# Generated by art/blender/build.py from the model scripts (big; rebuild them instead).
/art/models/
/art/previews/
# Made by tools/encyclopedia.py from the previews (rebuild it instead).
/art/encyclopedia/

# Python bytecode cache (made when the Blender scripts run)
__pycache__/
*.pyc
